{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Расчерчивание карты{% endblock %}

{% block page_actions %}
    <a class="btn btn-secondary" href="{{ tracer_url }}" target="_blank" rel="noopener noreferrer">
        <i class="fas fa-up-right-from-square"></i>
        Открыть в новой вкладке
    </a>
{% endblock %}

{% block main %}
    <div class="map-tracer-container">
        <iframe
            class="map-tracer-frame"
            src="{{ tracer_url }}"
            title="Расчерчивание маршрутов"
            loading="eager"
            allow="fullscreen; clipboard-read; clipboard-write"
            referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
    </div>

    <style>
        .map-tracer-container {
            overflow: hidden;
            width: 100%;
            min-height: 720px;
            height: calc(100vh - 150px);
            border: 1px solid var(--border-color);
            border-radius: var(--border-radius);
            background: #fff;
        }

        .map-tracer-frame {
            display: block;
            width: 100%;
            height: 100%;
            border: 0;
        }
    </style>
{% endblock %}
